{
  "name": "remex",
  "language": "python",
  "codeExt": ["py"],
  "outputDir": ".coherence/public",
  "sources": ["remex", "tests"],
  "testDir": "tests/",
  "test": ["python3", "-m", "pytest", "-q", "-k"],
  "testMatch": "[1-9]\\d* passed",
  "oracleExecution": "serial",
  "ignore": ["node_modules", ".git", ".venv", "__pycache__", ".pytest_cache", "bench", "docs"]
}
